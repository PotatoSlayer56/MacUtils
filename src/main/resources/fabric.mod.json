{
  "schemaVersion": 1,
  "id": "macutils",
  "version": "${version}",
  "name": "MacUtils",
  "description": "A small utility mod for macbox.minehut.gg",
  "authors": [
    "PotatoSlayer56"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/macutils",
    "source": "https://github.com/PotatoSlayer56/MacUtils"
  },
  "license": "CC0-1.0",
  "icon": "assets/macutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "potatoslayer56.macutils.MacUtils"
    ],
    "client": [
      "potatoslayer56.macutils.client.MacUtilsClient"
    ],
    "modmenu": [
      "potatoslayer56.macutils.client.config.ModMenuImplementation"
    ]
  },
  "mixins": [
    "macutils.mixins.json",
    {
      "config": "macutils.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~26.1.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/macutils"
      }
    }
  }
}